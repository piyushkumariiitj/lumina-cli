# ==============================================================================
# Lumina Stack - Environment Variables Configuration (.env.example)
#
# NOTE: This file is for DEVELOPERS / CONTRIBUTORS running the backend locally.
# End users installing '@piyushkumariiitj/lumina-cli' via npm DO NOT need this.
# ==============================================================================

# Express Server Port (Default: 3005)
PORT=3005

# PostgreSQL Database (Neon DB with pooled and direct URLs)
DATABASE_URL="postgresql://username:password@ep-sample-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://username:password@ep-sample.us-east-1.aws.neon.tech/neondb?sslmode=require"

# Better Auth Configuration (REQUIRED: the server refuses to start without a secret)
# Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET="your_random_32_character_secret_key_here"
BETTER_AUTH_URL="http://localhost:3005"

# GitHub OAuth App Credentials (create at: https://github.com/settings/developers)
GITHUB_CLIENT_ID="your_github_oauth_client_id"
GITHUB_CLIENT_SECRET="your_github_oauth_client_secret"

# Groq AI Inference Engine (get free key at: https://console.groq.com/keys)
GROQ_API_KEY="gsk_your_groq_api_key_here"
LUMINA_MODEL="openai/gpt-oss-120b"
LUMINA_FALLBACK_MODEL="openai/gpt-oss-20b"

# Web Client URL (Local frontend or deployed Vercel URL)
CLIENT_URL="http://localhost:3000"

# Extra browser origins allowed by CORS (comma-separated). CLIENT_URL is always allowed.
# CORS_ORIGINS="https://staging.example.com"

# --- AI proxy (/api/ai/proxy/v1) -----------------------------------------------
# Signed-in CLIs send model requests here; the server adds GROQ_API_KEY, so the key
# never leaves the server. Limits are per user and in-memory (single instance).
# LUMINA_PROXY_RPM=30                      # requests per minute per user
# LUMINA_PROXY_CONCURRENCY=4               # concurrent requests per user
# LUMINA_PROXY_MAX_OUTPUT_TOKENS=16384     # cap on max_tokens per request
# LUMINA_PROXY_TIMEOUT_MS=120000

# Old CLIs (<= 1.0.10) expect /api/ai/config to return GROQ_API_KEY itself.
# Leave unset (secure default). Set to "true" only for a short migration window.
# LUMINA_LEGACY_KEY_HANDOUT=true
